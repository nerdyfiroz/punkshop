# ==============================================================================
# PunkShop Environment Variables Configuration
# https://punkshop-flame.vercel.app
# ==============================================================================
# Note: Never commit real credentials or secrets to Git.
# Add these variables in your Vercel Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. Cloudflare R2 Private Video Storage (100% Free Tier: 10 GB / Zero Egress)
# ------------------------------------------------------------------------------
# Your Cloudflare Account ID (found on the right side of Cloudflare Dashboard -> R2)
R2_ACCOUNT_ID="your_cloudflare_account_id_hex"

# S3-compatible R2 API Token credentials (generated via R2 -> Manage R2 API Tokens)
# Ensure permission is set to "Object Read & Write"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"

# Private bucket name in Cloudflare R2 (default: punkshop-videos)
R2_BUCKET="punkshop-videos"

# ------------------------------------------------------------------------------
# 2. Admin Authentication & Session Security (Server-Side Only)
# ------------------------------------------------------------------------------
# Admin username for /admin login (default: admin)
ADMIN_USERNAME="admin"

# Strong administrator password for video uploads, editing, and pruning
# Never committed or exposed to the client bundle
ADMIN_PASSWORD="choose_a_strong_secret_password"

# Cryptographic secret used by HMAC-SHA256 to sign HttpOnly admin session cookies
# Generate with: openssl rand -hex 32
SESSION_SECRET="your_32_byte_random_cryptographic_secret_key"

# ------------------------------------------------------------------------------
# 3. Database Persistence (MongoDB Atlas Free M0 or Connection String)
# ------------------------------------------------------------------------------
# Stores video titles, descriptions, categories, thumbnails, R2 keys, sizes, and timestamps
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/punkshop?retryWrites=true&w=majority"

# ------------------------------------------------------------------------------
# 4. Site Host URLs
# ------------------------------------------------------------------------------
APP_URL="https://punkshop-flame.vercel.app"
VITE_APP_URL="https://punkshop-flame.vercel.app"
