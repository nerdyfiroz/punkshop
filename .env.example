# PunkShop Environment Variables Configuration
# For local development, copy this file to .env.local
# For Vercel, add these in Project Settings -> Environment Variables

# --- Admin Authentication (Vercel Env Vars) ---
# Set your custom admin login username and password here:
VITE_ADMIN_USERNAME="admin"
VITE_ADMIN_PASSWORD="your_secure_admin_password"

# --- Database Configuration (Vercel Env Vars) ---
# Supports PostgreSQL, Supabase, Neon, or Cloud SQL:
DATABASE_URL="postgresql://postgres:password@localhost:5432/punkshop_db"
VITE_DATABASE_URL="postgresql://postgres:password@localhost:5432/punkshop_db"

# --- Site URL ---
APP_URL="https://your-domain.vercel.app"
VITE_APP_URL="https://your-domain.vercel.app"

# Optional Gemini API Key (if adding AI summary features)
GEMINI_API_KEY=""
