# PunkShop Environment Variables Configuration
# Matches your exact Vercel Environment Variables setup:

# --- Admin Authentication (Vercel Env Vars) ---
# Supports both ADMIN_USERNAME and VITE_ADMIN_USERNAME:
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your_secure_admin_password"

# Optional VITE_ prefixed versions:
VITE_ADMIN_USERNAME="admin"
VITE_ADMIN_PASSWORD="your_secure_admin_password"

# --- MongoDB Database Configuration (Vercel Env Vars) ---
# Supports both MONGODB_URI and VITE_MONGODB_URI:
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/punkshop?retryWrites=true&w=majority"
VITE_MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/punkshop?retryWrites=true&w=majority"

# --- Site URL ---
APP_URL="https://your-domain.vercel.app"
VITE_APP_URL="https://your-domain.vercel.app"
